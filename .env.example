# Copy this file to .env.local and fill in the values. Never commit .env.local.

# WhatsApp number in international format, digits only, no "+" (e.g. 233241234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Resend (https://resend.com) API key, used to email reservations to you.
RESEND_API_KEY=

# Where reservations are sent. Separate several addresses with commas.
RESERVATION_TO_EMAIL=

# Sender shown on the email. Must use a domain you have verified in Resend,
# e.g. "Alpha Designs Website <bookings@alphadesigns.com.gh>".
# For testing before your domain is verified you can use: onboarding@resend.dev
RESERVATION_FROM_EMAIL=
